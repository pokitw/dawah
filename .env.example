# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# 1) FRONTEND (safe to ship to the browser)
# From Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 2) SEED SCRIPT ONLY (server side, keep secret, never commit)
# From Supabase dashboard -> Project Settings -> API -> service_role
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 3) EDGE FUNCTION SECRET (server side only - NEVER put this in the frontend)
# Set it with:  supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# The browser must never see this key.
ANTHROPIC_API_KEY=sk-ant-your-key-here
